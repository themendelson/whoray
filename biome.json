{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/dist", "!**/node_modules", "!test/fixtures"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "error",
        "useImportType": {
          "level": "error",
          "options": {
            "style": "separatedType"
          }
        },
        "useNodejsImportProtocol": "error",
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 400,
            "skipBlankLines": true
          }
        },
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["../**"],
                "message": "No ../ imports: use the # import (package.json \"imports\"), e.g. #parse/dates.ts."
              }
            ]
          }
        }
      },
      "complexity": {
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 60,
            "skipBlankLines": true,
            "skipIifes": true
          }
        },
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 20
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noImportCycles": "error",
        "noFocusedTests": "error",
        "noSkippedTests": "error",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": []
          }
        }
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "nursery": {
        "noConditionalExpect": "error",
        "noIdenticalTestTitle": "error",
        "useExpect": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/rdap/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../**"],
                    "message": "No ../ imports: use the # import (package.json \"imports\"), e.g. #parse/dates.ts."
                  },
                  {
                    "group": ["#whois/**"],
                    "message": "RDAP code can't import WHOIS code: a bundle that only asks RDAP should leave WHOIS out."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/data/**"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": "off"
          }
        }
      }
    },
    {
      "includes": ["test/**", "scripts/**", "src/cli.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "style": {
            "noExcessiveLinesPerFile": "off"
          },
          "complexity": {
            "noExcessiveLinesPerFunction": "off"
          }
        }
      }
    }
  ]
}
