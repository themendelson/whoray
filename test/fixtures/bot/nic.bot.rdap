 this website, the RDAP service, and these Terms and Conditions at any time without prior notice to you. You should review these Terms and Conditions each time you access or use the RDAP database and the RDAP service to learn of any changes. If you do not agree to the changes we have made, your only remedy is to stop your use of the RDAP database and the RDAP service. By executing a query, in any means whatsoever, you agree to these Terms of Service."],"links":[{"value":"https://rdap.nominet.uk/bot/domain/nic.bot","rel":"terms-of-service","href":"https://nominet.uk/rdap-tos","type":"text/html"}]},{"title":"Status Codes","description":["For more information on domain status codes, please visit https://icann.org/epp"],"links":[{"value":"https://rdap.nominet.uk/bot/domain/nic.bot","rel":"glossary","href":"https://icann.org/epp","type":"text/html"}]},{"title":"RDDS Inaccuracy Complaint Form","description":["URL of the ICANN RDDS Inaccuracy Complaint Form: https://icann.org/wicf"],"links":[{"value":"https://rdap.nominet.uk/bot/domain/nic.bot","rel":"help","href":"https://icann.org/wicf","type":"text/html"}]}],"events":[{"eventAction":"registration","eventActor":"9999","eventDate":"2013-09-16T18:56:56Z"},{"eventAction":"last changed","eventActor":"9999","eventDate":"2026-07-22T08:00:32Z"},{"eventAction":"expiration","eventDate":"2030-09-16T18:56:56Z"},{"eventAction":"last update of RDAP database","eventDate":"2026-10-16T18:51:58.201519126Z"}],"status":["server transfer prohibited","server update prohibited","server delete prohibited"],"handle":"D_2503430-BOT","ldhName":"nic.bot","unicodeName":"nic.bot","nameservers":[{"objectClassName":"nameserver","links":[{"value":"https://rdap.nominet.uk/bot/nameserver/dns1.nic.bot","rel":"self","href":"https://rdap.nominet.uk/bot/nameserver/dns1.nic.bot","type":"application/rdap+json"}],"events":[{"eventAction":"registration","eventActor":"9999","eventDate":"2018-11-20T14:32:58Z"}],"status":["active","associated"],"handle":"DNS1_NIC_B