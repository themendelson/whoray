{
  "name": "whoray",
  "version": "0.1.0",
  "description": "WHOIS and RDAP lookups for any domain, with expiry and drop dates",
  "keywords": [
    "whois",
    "rdap",
    "domain",
    "tld",
    "registrar",
    "availability",
    "expiry",
    "drop"
  ],
  "license": "MIT",
  "author": "Amir Mendelson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themendelson/whoray.git"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@10.8.1",
  "files": [
    "dist"
  ],
  "bin": {
    "whoray": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "workerd": {
        "types": "./dist/workerd.d.ts",
        "default": "./dist/workerd.js"
      },
      "browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "default": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      }
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/node.d.ts",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "biome check . && oxlint --type-aware && knip && jscpd",
    "format": "biome check --write .",
    "typecheck": "tsc",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "fixture": "node --experimental-strip-types --no-warnings scripts/fixture.ts",
    "prepublishOnly": "pnpm check && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22",
    "jscpd": "5.4.1",
    "knip": "6.41.0",
    "oxc-parser": "0.154.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "unrun": "0.3.1",
    "vitest": "5.0.5"
  }
}
